{
  "manifest_version": 3,
  "name": "RSC Doc to Smart Data (v2)",
  "version": "2.1.1",
  "description": "สกัดข้อมูลจากเอกสารราชการ (.docx/.pdf) แล้วกรอกลงแบบฟอร์มเว็บอัตโนมัติ — Dynamic Mapping จาก Backend (FastAPI)",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://rsc-approval.kmutt.ac.th/*",
    "https://rsc-extraction-api.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:7860/*",
    "http://localhost:7860/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RSC Doc to Smart Data",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
